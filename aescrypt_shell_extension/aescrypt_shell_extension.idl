// This file will be processed by the MIDL tool to
// produce the type library (aescrypt_shell_extension.tlb) and marshalling code.

import "oaidl.idl";
import "ocidl.idl";

[
    object,
    uuid(3E228AAF-683B-44AD-A8DA-3FC8EF25008A),
    helpstring("IAECryptContextMenu Interface"),
    pointer_default(unique)
]
interface IAESCryptContextMenu : IUnknown{
};
[
    uuid(EB9FFF86-F4EC-4882-B45E-90C4EB1ECC07),
    version(4.0),
    helpstring("AES Crypt Shell Extension Type Library")
]
library AESCryptShellExtensionLib
{
    importlib("stdole2.tlb");
    [
        uuid(35872D53-3BD4-45FA-8DB5-FFC47D4235E7),
        helpstring("AESCryptContextMenuCom Class")
    ]
    coclass AESCryptContextMenuCom
    {
        [default] interface IAESCryptContextMenu;
    };
};
